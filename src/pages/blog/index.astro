---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Blog" description={`All posts on ${SITE_TITLE}.`} />
		<style>
			h1 {
				margin-top: 0.3em;
			}
			ul {
				list-style: none;
				margin: 1.5em 0 0;
				padding: 0;
			}
			li {
				display: flex;
				gap: 1.4em;
				align-items: flex-start;
				padding: 1.3em 0;
				border-bottom: 1px solid rgb(var(--line));
				margin: 0;
			}
			li a {
				display: block;
				text-decoration: none;
			}
			.thumb {
				flex: 0 0 160px;
			}
			.thumb img {
				display: block;
				border-radius: 10px;
				margin: 0;
			}
			h2 {
				font-size: 1.25em;
				margin: 0.15em 0 0.25em;
			}
			a:hover h2 {
				color: var(--accent-dark);
			}
			.date {
				font-family: var(--mono);
				font-size: 0.8rem;
				color: rgb(var(--muted));
				margin: 0;
			}
			.desc {
				margin: 0;
				font-size: 0.95em;
				color: rgb(var(--muted));
			}
			.empty {
				padding: 2.5em 0;
				color: rgb(var(--muted));
			}
			@media (max-width: 640px) {
				li {
					flex-direction: column;
					gap: 0.6em;
				}
				.thumb {
					flex-basis: auto;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="eyebrow">Posts</p>
			<h1>Blog</h1>
			{posts.length === 0 ? (
				<p class="empty">The first post is on its way. Subscribe via <a href="/rss.xml">RSS</a> to get it when it lands.</p>
			) : (
				<ul>
					{posts.map((post) => (
						<li>
							{post.data.heroImage && (
								<a class="thumb" href={`/blog/${post.id}/`}>
									<Image width={320} height={160} src={post.data.heroImage} alt="" />
								</a>
							)}
							<div>
								<a href={`/blog/${post.id}/`}>
									<p class="date"><FormattedDate date={post.data.pubDate} /></p>
									<h2>{post.data.title}</h2>
									<p class="desc">{post.data.description}</p>
								</a>
							</div>
						</li>
					))}
				</ul>
			)}
		</main>
		<Footer />
	</body>
</html>
