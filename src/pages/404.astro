---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Page not found" description="The page you are looking for does not exist." />
		<style>
			main {
				text-align: center;
			}
			.code {
				font-family: var(--mono);
				font-size: 4em;
				font-weight: 700;
				color: rgb(var(--ink));
				margin: 0.4em 0 0.1em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="eyebrow">404</p>
			<p class="code">Not found</p>
			<p class="muted">This page doesn't exist. It happens — even to people who test for a living.</p>
			<p><a href="/">Back to the homepage</a></p>
		</main>
		<Footer />
	</body>
</html>
