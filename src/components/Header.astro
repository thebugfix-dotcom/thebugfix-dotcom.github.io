---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="brand" href="/">
			<svg class="mark" viewBox="0 0 128 128" width="26" height="26" aria-hidden="true">
				<rect width="128" height="128" rx="26" fill="#0f172a"></rect>
				<text x="26" y="84" font-family="ui-monospace, Menlo, monospace" font-size="54" font-weight="700" fill="#34d399">&gt;_</text>
			</svg>
			<span class="wordmark">{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0 1em;
		background: rgba(11, 15, 20, 0.85);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid rgb(var(--line));
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 880px;
		margin: 0 auto;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.55em;
		padding: 0.7em 0;
		text-decoration: none;
	}
	.mark {
		display: block;
		border-radius: 6px;
	}
	.wordmark {
		font-weight: 700;
		font-size: 1.05rem;
		color: rgb(var(--ink));
		letter-spacing: -0.01em;
	}
	.internal-links {
		display: flex;
	}
	nav :global(a.nav-link) {
		padding: 1em 0.65em;
		color: rgb(var(--body));
		font-size: 0.95rem;
		border-bottom: 2px solid transparent;
	}
	nav :global(a.nav-link:hover) {
		color: rgb(var(--ink));
	}
	nav :global(a.nav-link.active) {
		color: rgb(var(--ink));
		font-weight: 700;
		border-bottom-color: var(--accent);
	}
	@media (max-width: 480px) {
		.wordmark {
			display: none;
		}
	}
</style>
